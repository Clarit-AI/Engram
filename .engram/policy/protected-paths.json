{
  "version": 1,
  "description": "Shared protected-path policy for Engram upstream sync automation and local agent guardrails.",
  "static_protected_globs": [
    ".claude/skills/**",
    ".engram/**",
    ".github/FUNDING.yml",
    ".github/workflows/ci-failure-monitor.yml",
    ".github/workflows/nightly-test-*.yml",
    ".github/workflows/pr-test-*.yml",
    ".github/workflows/pr-test.yml",
    ".github/workflows/release-*.yml",
    ".github/workflows/upstream-sync.yml",
    ".gitignore",
    ".pre-commit-config.yaml",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "SECURITY.md",
    "docs/migration-prep/**",
    "docs/references/production_request_trace.md",
    "docs/stateful_mamba/**",
    "docs/wiki-pages/**",
    "engram.json",
    "funding.json",
    "python/sglang/__init__.py",
    "python/sglang/snapshot.py",
    "python/sglang/srt/agents/**",
    "python/sglang/srt/configs/__init__.py",
    "python/sglang/srt/configs/mamba2.py",
    "python/sglang/srt/configs/model_config.py",
    "python/sglang/srt/entrypoints/http_server.py",
    "python/sglang/srt/entrypoints/openai/protocol.py",
    "python/sglang/srt/entrypoints/openai/serving_chat.py",
    "python/sglang/srt/entrypoints/openai/serving_completions.py",
    "python/sglang/srt/layers/attention/mamba/mamba2_metadata.py",
    "python/sglang/srt/managers/io_struct.py",
    "python/sglang/srt/managers/schedule_batch.py",
    "python/sglang/srt/managers/scheduler.py",
    "python/sglang/srt/managers/scheduler_output_processor_mixin.py",
    "python/sglang/srt/managers/tokenizer_manager.py",
    "python/sglang/srt/mem_cache/mamba_radix_cache.py",
    "python/sglang/srt/mem_cache/memory_pool.py",
    "python/sglang/srt/model_executor/model_runner.py",
    "python/sglang/srt/model_executor/pool_configurator.py",
    "python/sglang/srt/models/mamba2.py",
    "python/sglang/srt/models/nemotron_h.py",
    "python/sglang/srt/observability/**",
    "python/sglang/srt/server_args.py",
    "python/sglang/srt/snapshot/**",
    "python/sglang/srt/utils/common.py",
    "python/sglang/srt/utils/hf_transformers/**",
    "scripts/ci/utils/diffusion/generate_diffusion_dashboard.py",
    "scripts/ci/utils/slash_command_handler.py",
    "sgl-kernel/benchmark/bench_fp4_gemm.py",
    "test/phases/**",
    "test/registered/**",
    "test/sglang/agents/**",
    "test/sglang/snapshot/**"
  ],
  "local_only_globs": [
    ".claude/local-notes.md"
  ],
  "enforcement": {
    "local_ack_env": "ENGRAM_ALLOW_PROTECTED_EDITS"
  }
}
